# CyberShield Mail Environment Configuration Example
# Copy this file to .env and configure your values

# Application Port
PORT=8080

# Allowed CORS Origins (comma-separated or * for development)
CORS_ORIGINS=*

# SQLite Database Storage Path
CYBERSHIELD_DB_PATH=data/cybershield_store.db

# Optional Gmail IMAP Credentials (can also be entered via UI)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Cloud & Firebase Configuration
GCP_PROJECT_ID=cybershield-mail-prod
GCP_REGION=us-central1
FIREBASE_PROJECT_ID=cybershield-mail-prod
